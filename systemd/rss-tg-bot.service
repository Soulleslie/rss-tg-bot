[Unit]
Description=RSS to Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/rss-tg-bot
ExecStart=/opt/rss-tg-bot/.venv/bin/python /opt/rss-tg-bot/app.py
Restart=on-failure
RestartSec=5
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
