# Keep this file public; never commit the real .env file.
TG_BOT_TOKEN=
# First start the bot, send /whoami, then add your ID below and restart it.
ADMIN_USER_IDS=
# Empty means anyone who can find the bot may use it. Use a comma-separated whitelist in production.
ALLOWED_USER_IDS=
# How often RSS feeds are checked, in seconds (minimum 10).
POLL_INTERVAL_SECONDS=60
MAX_TARGETS_PER_USER=10
# Optional settings (defaults shown):
# FETCH_TIMEOUT_SECONDS=20       # give up on a feed that does not answer in time
# FETCH_CONCURRENCY=4            # how many feeds are downloaded at the same time
# DELIVERY_RETENTION_DAYS=180    # keep /history records this long; 0 keeps them forever
# DISPLAY_TIMEZONE=Asia/Shanghai # time zone used in /history and /feedstatus
